{
  "name": "grabbly",
  "version": "2.0.4",
  "description": "Grabbly: bulk media downloader for social profiles",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/media.test.js",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:win": "electron-builder --win --x64",
    "mobile:build": "node scripts/build-mobile.js && cap sync",
    "android:debug": "npm run mobile:build && cd android && ./gradlew assembleDebug",
    "android:open": "npm run mobile:build && cap open android",
    "ios:open": "npm run mobile:build && cap open ios"
  },
  "devDependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-inappbrowser": "^8.25.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.obudilovsky.grabbly",
    "productName": "Grabbly",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable.${ext}"
    }
  }
}
